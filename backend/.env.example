# Environment Settings
APP_ENV=development
DATABASE_URL=sqlite:///./influencer_crm.db

# Anthropic Claude API Key
# Sign up at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Instagram Graph API (Official Business Discovery)
# Requires an Instagram Professional / Business account linked to a Meta Facebook Page
INSTAGRAM_ACCESS_TOKEN=your_meta_system_user_or_page_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Google Sheets CRM Integration
# Service account JSON file downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Influencer Outreach CRM

# Gmail API Integration
# OAuth Client JSON and generated token JSON
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_USER_EMAIL=me

# Sending limits and throttling
DAILY_SEND_LIMIT=30
SEND_DELAY_SECONDS=3
DEFAULT_SENDER_NAME=Alex - Partnerships Lead
DEFAULT_BRAND_NAME=Aura Glow Beauty

# Background Schedulers
FOLLOWUP_CHECK_INTERVAL_HOURS=1
REPLY_POLL_INTERVAL_MINUTES=5
